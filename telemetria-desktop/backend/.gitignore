*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Estado de trabalho do gerar_catalogo.py: so existe durante uma coleta
# e pode ser apagado quando ela termina (o resultado fica no
# catalogo_veiculos.json, que continua versionado).
catalogo_progresso.json
catalogo_progresso.json.tmp

# Logs
*.log

